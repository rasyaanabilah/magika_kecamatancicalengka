rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserRole(uid, role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid)) && getUserData(uid).role == role;
    }

    function isStaff(uid) {
      return hasUserRole(uid, 'admin') || hasUserRole(uid, 'petugas') || hasUserRole(uid, 'camat');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff(request.auth.uid));
      
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.namaLengkap is string
        && request.resource.data.namaLengkap.size() <= 200
        && request.resource.data.role in ['student', 'admin', 'camat', 'petugas']
        && (request.resource.data.role == 'student' || request.auth.token.email.matches('.*@magika\\.go\\.id$'));

      allow update: if isSignedIn() && (request.auth.uid == userId || hasUserRole(request.auth.uid, 'admin'))
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && (request.resource.data.role == resource.data.role || hasUserRole(request.auth.uid, 'admin'))
        && (request.resource.data.namaLengkap is string && request.resource.data.namaLengkap.size() <= 200);
        
      allow delete: if isSignedIn() && hasUserRole(request.auth.uid, 'admin');
    }

    // --- PENDAFTAR MAGANG COLLECTION ---
    match /pendaftar_magang/{pendaftarId} {
      // Allow single document fetch (tracking) by ID for anyone
      allow get: if true;

      allow list: if isSignedIn() && (
        isStaff(request.auth.uid)
        || resource.data.userEmail == request.auth.token.email
      );

      allow create: if isSignedIn() && isValidId(pendaftarId)
        && request.resource.data.id == pendaftarId
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == 'Menunggu Verifikasi'
        && request.resource.data.namaLengkap is string 
        && request.resource.data.namaLengkap.size() <= 200
        && request.resource.data.noHp is string
        && request.resource.data.noHp.size() <= 30;

      allow update: if isSignedIn() && isValidId(pendaftarId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.userEmail == resource.data.userEmail
        && (
          // Student self-update
          (
            request.auth.token.email == resource.data.userEmail
            && resource.data.status != 'Diterima' 
            && resource.data.status != 'Ditolak'
            && request.resource.data.status == resource.data.status
            && request.resource.data.namaLengkap is string
            && request.resource.data.namaLengkap.size() <= 200
          ) 
          || 
          // Staff/Admin updates
          (
            isStaff(request.auth.uid)
          )
        );

      allow delete: if isSignedIn() && (
        (request.auth.token.email == resource.data.userEmail && resource.data.status == 'Menunggu Verifikasi')
        || hasUserRole(request.auth.uid, 'admin')
      );
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isStaff(request.auth.uid);
    }

    // --- SURAT COLLECTION ---
    match /surat/{suratId} {
      allow read: if isSignedIn() && (
        isStaff(request.auth.uid)
        || (request.auth.uid in resource.data.penerimaIds)
        || (request.auth.token.email in resource.data.penerimaIds)
        || (request.auth.token.email.lower() in resource.data.penerimaIds)
      );
      allow create, update, delete: if isSignedIn() && isStaff(request.auth.uid);
    }
  }
}
